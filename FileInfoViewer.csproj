<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\FileInfoViewer.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Authors>SweWolf</Authors>
    <AssemblyTitle>File Info Viewer</AssemblyTitle>
    <Description>Collects and displays detailed metadata about files in a rich, self-contained HTML report.</Description>
    <Company>SweWolf Software</Company>
    <Product>File Info Viewer</Product>
    <Copyright>SweWolf Software</Copyright>
    <RepositoryUrl>https://github.com/SweWolf/FileInfoViewer</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\FileInfoViewer.png" />
  </ItemGroup>

</Project>
